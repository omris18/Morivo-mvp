rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    match /experiences/{experienceId}/media/{uid}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.size < 15 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow update, delete: if signedIn() && request.auth.uid == uid;
    }
  }
}

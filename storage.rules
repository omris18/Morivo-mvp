rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isExperienceOwner(experienceId) {
      return signedIn() && firestore.get(/databases/(default)/documents/experiences/$(experienceId)).data.ownerUid == request.auth.uid;
    }
    match /experiences/{experienceId}/media/{uid}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && (
        (request.resource.contentType.matches('image/.*') && request.resource.size < 15 * 1024 * 1024) ||
        (request.resource.contentType.matches('video/.*') && request.resource.size < 100 * 1024 * 1024)
      );
      allow update, delete: if signedIn() && (request.auth.uid == uid || isExperienceOwner(experienceId));
    }
  }
}

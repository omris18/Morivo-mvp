rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMaster() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'omris18@gmail.com';
    }
    function isExperienceOwner(experienceId) {
      return signedIn() && (isMaster() || get(/databases/$(database)/documents/experiences/$(experienceId)).data.ownerUid == request.auth.uid);
    }

    function isParticipant(experienceId, participantId) {
      let sessionPath = /databases/$(database)/documents/experiences/$(experienceId)/participantSessions/$(request.auth.uid);
      return signedIn() && (exists(sessionPath)
        ? get(sessionPath).data.participantId == participantId
        : request.auth.uid == participantId);
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /experiences/{experienceId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      // Participants only ever need to READ the experience (to see missions/status) - every
      // legitimate write (Studio edits, publish, pause) is organizer-only. A joined participant
      // must never be able to update or delete the experience document itself.
      allow read: if signedIn() && (
        isMaster() ||
        resource.data.ownerUid == request.auth.uid ||
        exists(/databases/$(database)/documents/experiences/$(experienceId)/participants/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/experiences/$(experienceId)/participantSessions/$(request.auth.uid)) ||
        resource.data.memoryPublic == true
      );
      allow update: if signedIn() && (isMaster() || resource.data.ownerUid == request.auth.uid)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && (isMaster() || resource.data.ownerUid == request.auth.uid);

      match /participantSessions/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
      match /participants/{uid} {
        allow read: if signedIn();
        allow create: if false;
        allow update: if isParticipant(experienceId, uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pushToken']);
        allow delete: if signedIn() && (request.auth.uid == uid || isExperienceOwner(experienceId));
      }

      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow delete: if isExperienceOwner(experienceId);
      }

      match /media/{mediaId} {
        allow read: if signedIn();
        allow create: if signedIn() && isParticipant(experienceId, request.resource.data.uid);
        allow update: if signedIn() && (isParticipant(experienceId, resource.data.uid) || isMaster());
        allow delete: if signedIn() && (isParticipant(experienceId, resource.data.uid) || isExperienceOwner(experienceId));
      }
      match /progress/{uid} {
        allow read: if signedIn();
        allow create: if isParticipant(experienceId, uid)
          && request.resource.data.points == 0
          && request.resource.data.completedMissionIds.size() == 0;
        // A participant can only ever move their own progress forward - points capped to a
        // sane per-write increase (max single mission is 200) and at most one mission marked
        // done per write - so a client can't just set points/completedMissionIds to anything.
        allow update: if signedIn() && (
          isExperienceOwner(experienceId) ||
          (isParticipant(experienceId, uid)
            && request.resource.data.points is number
            && request.resource.data.points >= resource.data.points
            && request.resource.data.points <= resource.data.points + 500
            && request.resource.data.completedMissionIds.size() <= resource.data.completedMissionIds.size() + 1)
        );
        allow delete: if signedIn() && (request.auth.uid == uid || isExperienceOwner(experienceId));
      }

      // One vote doc per participant, for the "let the group vote" first-mission location
      // poll - participants can only ever write their own vote; the organizer's final pick
      // lives on the experience doc itself (locationDecisions), not here.
      match /locationVotes/{uid} {
        allow read: if signedIn();
        allow create, update: if isParticipant(experienceId, uid)
          && request.resource.data.missionId is string
          && request.resource.data.optionId is string;
        allow delete: if signedIn() && (request.auth.uid == uid || isExperienceOwner(experienceId));
      }

      match /answers/{answerId} {
        allow read: if signedIn();
        allow create: if signedIn() && isParticipant(experienceId, request.resource.data.uid)
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
        allow update: if signedIn() && isParticipant(experienceId, resource.data.uid)
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
        allow delete: if signedIn() && (isParticipant(experienceId, resource.data.uid) || isExperienceOwner(experienceId));
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if isExperienceOwner(experienceId)
          && request.resource.data.text is string && request.resource.data.text.size() <= 500;
        allow delete: if isExperienceOwner(experienceId);
      }

      // Cached AI translations of the experience's own content, one per target language -
      // only the translateExperience Cloud Function writes here (via admin credentials,
      // which bypass these rules entirely); clients may only ever read a cached translation.
      match /translations/{lang} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // Generated site-wide brand/marketing art (hero panels, loading backdrops) - only the
    // generateBrandImage Cloud Function writes here (via admin credentials, which bypass
    // these rules entirely); clients may only ever read the current image URL.
    match /siteAssets/{key} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /publicExperiences/{joinCode} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (isMaster() || request.resource.data.ownerUid == request.auth.uid);
      allow delete: if signedIn() && (isMaster() || resource.data.ownerUid == request.auth.uid);
    }

    // Pre-registered personal codes (one per named participant, meant for NFC tags) -
    // resolved on tap without needing the shared join code.
    match /participantCodes/{code} {
      // Bearer links may be resolved only by the callable. Do not expose every
      // participant's resumable link to other participants through a collection query.
      allow read: if signedIn() && (isMaster() || resource.data.ownerUid == request.auth.uid);
      allow create, update: if false;
      allow delete: if signedIn() && (isMaster() || resource.data.ownerUid == request.auth.uid);
    }
  }
}
